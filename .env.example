# ==============================================
# ASL Bridge AI: Environment Configuration Template
# ==============================================

# Node.js Application Gateway (Backend)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_asl_bridge_2026_change_in_production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Database
MONGODB_URI=mongodb://localhost:27017/asl_bridge_ai

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Python AI Microservice (ai-service/.env)
AI_PORT=8000
AI_HOST=0.0.0.0
AI_ENV=development
OCR_ENGINE=tesseract
SIMILARITY_THRESHOLD=0.65
EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_TRANSLATION_STRATEGY=rag_grounded
MAX_UPLOAD_SIZE_MB=10
