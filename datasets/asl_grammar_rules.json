{
  "version": "1.0.0",
  "name": "ASL Grammatical Transformation Matrix",
  "description": "Linguistic rules for transforming English syntactic structures into American Sign Language gloss sequences",
  "omission_rules": {
    "articles": ["a", "an", "the"],
    "copulas": ["is", "am", "are", "was", "were", "be", "being", "been"],
    "auxiliary_do": ["do", "does", "did"]
  },
  "pronoun_mappings": {
    "i": "I",
    "me": "ME",
    "my": "MY",
    "mine": "MINE",
    "myself": "MYSELF",
    "you": "YOU",
    "your": "YOUR",
    "yours": "YOURS",
    "yourself": "YOURSELF",
    "he": "HE",
    "she": "SHE",
    "it": "IT",
    "him": "HE",
    "her": "SHE",
    "his": "HIS",
    "hers": "HERS",
    "we": "WE",
    "us": "US",
    "our": "OUR",
    "ours": "OURS",
    "they": "THEY",
    "them": "THEY",
    "their": "THEIR",
    "theirs": "THEIRS"
  },
  "temporal_markers": [
    "yesterday", "today", "tomorrow", "now", "later", "before", "past", "future",
    "morning", "afternoon", "night", "tonight", "daily", "always", "never",
    "sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday",
    "last week", "next week", "last year", "next year"
  ],
  "wh_question_words": [
    "who", "what", "where", "when", "why", "which", "how", "how much", "how many"
  ],
  "negation_words": [
    "not", "no", "never", "none", "nothing", "nowhere", "cannot", "can't", "don't", "doesn't", "didn't", "won't"
  ],
  "transformation_patterns": [
    {
      "pattern_id": "wh_question",
      "description": "Move WH-words to the terminal clause position and append {q} non-manual signal marker",
      "example_en": "Where is the bathroom?",
      "example_asl": "BATHROOM WHERE {q}"
    },
    {
      "pattern_id": "time_topic_comment",
      "description": "Front temporal markers to the initial clause position followed by Topic then Comment",
      "example_en": "I will visit the doctor tomorrow",
      "example_asl": "TOMORROW DOCTOR I VISIT"
    },
    {
      "pattern_id": "negation_shift",
      "description": "Attach negative marker directly adjacent to the main verb/predicate with {neg} marker",
      "example_en": "I do not understand",
      "example_asl": "I UNDERSTAND NOT {neg}"
    },
    {
      "pattern_id": "yes_no_question",
      "description": "Retain topic-comment order with final pronoun copy and {yn_q} marker",
      "example_en": "Are you hungry?",
      "example_asl": "YOU HUNGRY YOU {yn_q}"
    }
  ]
}
